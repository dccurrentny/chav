# Copied to /etc/portal/portal.env by provision.sh. NEVER commit the real file.
# SESSION_SECRET is generated during provisioning; the NS_* values are yours to fill in.

NODE_ENV=production
PORT=3000
PORTAL_ORIGIN=https://portal.dccurrentny.com

# Generated by provision.sh. Rotating it signs everyone out.
SESSION_SECRET=replace-me-with-32-plus-random-bytes

# --- SkySwitch / NetSapiens ---
# NS_BASE_URL is your portal host, e.g. https://dccurrent.example.skyswitch.com
NS_BASE_URL=https://REPLACE-ME
NS_CLIENT_ID=
NS_CLIENT_SECRET=
NS_USERNAME=
NS_PASSWORD=
NS_TIMEOUT_MS=15000

# --- SkySwitch Telco API (numbers, routing, e911, porting, billing) ---
# A different server from the PBX, with its own credentials. Request a client
# ID and secret from SkySwitch Control Tower. These can also be set from the
# staff console, which is easier and stores them encrypted.
#
# Scopes are requested by us, so list only what this portal needs. The full set
# includes billing and back_office; a token that never asks for them cannot
# reach them.
TELCO_BASE_URL=https://api.skyswitch.com
TELCO_AUTH_STYLE=oauth2
TELCO_TOKEN_PATH=/oauth/token
TELCO_SCOPES=phone_number routing e911
TELCO_CLIENT_ID=
TELCO_CLIENT_SECRET=
TELCO_USERNAME=
TELCO_PASSWORD=

SESSION_TTL_HOURS=12
LOG_LEVEL=info

# Hostname for the staff console. It answers here and NOWHERE else — the API
# 404s admin endpoints on any other host, and Caddy serves the admin bundle
# only from this block. Leave it blank and no console is exposed at all.
ADMIN_HOSTNAME=admin.dccurrentny.com

# The shared customer portal: one address any customer can sign in to, where
# the account decides which customer it is rather than the hostname. Customers
# who want their own address still get one; this is the default door for
# everyone else, so the bare portal domain is not claimed by whoever is first.
# Leave blank and every customer needs their own address.
SHARED_PORTAL_HOSTNAME=portal.dccurrentny.com
