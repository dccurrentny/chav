# Copied to /etc/portal/portal.env by provision.sh. NEVER commit the real file.
# SESSION_SECRET is generated during provisioning; the NS_* values are yours to fill in.

NODE_ENV=production
PORT=3000
PORTAL_ORIGIN=https://portal.dccurrentny.com

# Generated by provision.sh. Rotating it signs everyone out.
SESSION_SECRET=replace-me-with-32-plus-random-bytes

# --- SkySwitch / NetSapiens ---
# NS_BASE_URL is your portal host, e.g. https://dccurrent.example.skyswitch.com
NS_BASE_URL=https://REPLACE-ME
NS_CLIENT_ID=
NS_CLIENT_SECRET=
NS_USERNAME=
NS_PASSWORD=
NS_TIMEOUT_MS=15000

SESSION_TTL_HOURS=12
LOG_LEVEL=info
