{
	# On-demand TLS: a certificate is obtained the first time a customer's
	# hostname is requested, so adding a customer needs no Caddy change.
	#
	# The `ask` endpoint is what makes this safe. Without it, anyone who points
	# a DNS record at this droplet would make us request a certificate on their
	# behalf — burning Let's Encrypt rate limits and letting a stranger mint
	# certs against our IP. The portal answers 200 only for a hostname that
	# belongs to an active tenant.
	on_demand_tls {
		ask      http://127.0.0.1:3000/internal/tls-check
		interval 2m
		burst    5
	}
}

# One site block serves every customer. Which customer a request belongs to is
# decided by the hostname, server-side, in server/src/tenant.js.
https:// {
	tls {
		on_demand
	}

	encode gzip zstd

	# /internal/* is deliberately NOT proxied. The TLS gate is reachable from
	# loopback only, where Caddy calls it directly.
	handle /internal/* {
		respond "not found" 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:3000
	}
	handle /readyz {
		reverse_proxy 127.0.0.1:3000
	}

	# The themed single-page app. It brands itself per hostname from
	# /api/branding, so there is one build, not one per customer.
	handle {
		root * /opt/chav/public
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		X-Frame-Options           "DENY"
		-Server
	}

	log {
		output file /var/log/caddy/portal.log {
			roll_size 20mb
			roll_keep 10
		}
	}
}

# Plain HTTP redirects to HTTPS for any hostname.
http:// {
	redir https://{host}{uri} permanent
}
